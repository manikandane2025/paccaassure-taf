# PaccaAssureTAF sandbox (Northwind Health) settings: the template for sandbox/.env.
#
# `uv run python scripts/dev.py sandbox-up` copies this file to sandbox/.env when that file is missing.
# Edit sandbox/.env (gitignored, local to your machine), not this template. docker compose reads
# sandbox/.env automatically; scripts/dev.py sandbox-smoke reads the ports from it. Values left
# out fall back to the defaults in sandbox/compose.yaml (the same values as below).
#
# Synthetic, local-only values. Every port binds to 127.0.0.1 only.
# Port clash with another service? Pick a free port and change it in sandbox/.env:
#   netstat -ano | findstr :18081        (Windows)
#   ss -ltn | grep 18081                 (Linux)
# Prefix NWH_SANDBOX_ (never PATAF_): pataf rejects unknown PATAF_* variables.
# Synthetic credentials contain "Northwind" (gitleaks allowlist, CONFIG_SECRETS_DATA).

# Northwind Health web app (nginx + SPA; proxies /api/ to the API)
NWH_SANDBOX_WEB_PORT=18081
# Reserved for the Tomcat JSP app (Phase 6 prerequisite)
NWH_SANDBOX_JSP_PORT=18082
# Northwind Health JSON API (FastAPI; OpenAPI at /openapi.json, docs at /docs)
NWH_SANDBOX_API_PORT=18083
# Postgres 16: databases northwind (app data) and pataf_history (history store)
NWH_SANDBOX_DB_PORT=15433

# Database passwords apply when the data volume is first created (dev.py sandbox-down removes it).
NWH_SANDBOX_DB_SUPERUSER_PASSWORD=pw-Northwind-postgres
NWH_SANDBOX_DB_APP_PASSWORD=pw-Northwind-app
NWH_SANDBOX_DB_READONLY_PASSWORD=pw-Northwind-readonly
NWH_SANDBOX_DB_HISTORY_PASSWORD=pw-Northwind-history

# API bearer tokens (HMAC-signed). Lower the TTL to test token expiry and re-authentication.
NWH_SANDBOX_TOKEN_SECRET=ts-Northwind-signing-key
NWH_SANDBOX_TOKEN_TTL_SECONDS=3600
